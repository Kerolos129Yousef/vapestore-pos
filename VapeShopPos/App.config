<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Database file name. Created next to the executable on first run. -->
    <add key="DatabaseFileName" value="vapeshop.db" />
  </appSettings>
</configuration>
